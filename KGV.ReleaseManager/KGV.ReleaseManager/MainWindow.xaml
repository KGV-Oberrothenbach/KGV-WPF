<Window x:Class="KGV.ReleaseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KGV Release Manager"
        Width="1250"
        Height="720"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18" CornerRadius="12" BorderThickness="1" BorderBrush="#D7E2D3" Background="#FFFFFF">
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="Bold" Text="KGV Release Manager" />
                <TextBlock Margin="0,8,0,0" Foreground="#5E6F62" TextWrapping="Wrap"
                           Text="Wähle Windows, Android oder beide Releases. Major und Minor kannst du manuell setzen, Patch wird automatisch vorgeschlagen. Danach wird der komplette Release-Ablauf intern ausgeführt und das gesamte KGV-Projekt kann committed werden." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Oben: Pfade + Auswahl/Aktionen nebeneinander -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Projektpfade" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="KGV-Projektordner" />
                            <TextBox x:Name="RepoRootTextBox" Grid.Row="0" Grid.Column="1" Margin="8,0,8,8" Padding="6" />
                            <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Padding="10,6" Click="BrowseRepoRoot_Click" Content="Ordner..." />

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Publish-Root" />
                            <TextBox x:Name="PublishRootTextBox" Grid.Row="1" Grid.Column="1" Margin="8,0,8,8" Padding="6" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" Padding="10,6" Click="BrowsePublishRoot_Click" Content="Ordner..." />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="GitHub-Ordner" />
                            <TextBox x:Name="GitHubRootTextBox" Grid.Row="2" Grid.Column="1" Margin="8,0,8,0" Padding="6" />
                            <Button Grid.Row="2" Grid.Column="2" Padding="10,6" Click="BrowseGitHubRoot_Click" Content="Ordner..." />
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Column="2">
                        <GroupBox Header="Release-Auswahl" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WpfOnlyRadioButton" GroupName="ReleaseChoice" Content="Nur Windows-App" Margin="0,0,16,0" />
                                <RadioButton x:Name="AndroidOnlyRadioButton" GroupName="ReleaseChoice" Content="Nur Android-App" Margin="0,0,16,0" />
                                <RadioButton x:Name="BothRadioButton" GroupName="ReleaseChoice" Content="Beide" IsChecked="True" />
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Margin="0,10,0,0">
                            <WrapPanel>
                                <Button x:Name="LoadVersionsButton" Width="150" Padding="12,8" Margin="0,0,10,10" Click="LoadVersions_Click" Content="Versionen laden" />
                                <Button x:Name="StartReleaseButton" Width="170" Padding="12,8" Margin="0,0,10,10" Click="StartRelease_Click" Content="Release starten" />
                            </WrapPanel>
                            <CheckBox x:Name="CommitProjectCheckBox" VerticalAlignment="Center" IsChecked="True" Content="KGV-Projekt nach erfolgreichem Release committen" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Mitte: Versions-/Plattformdaten -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Windows-Version" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" Text="Major" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" Text="Minor" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" Text="Patch" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Margin="8,0,0,6" Text="Aktuell" />

                            <TextBox x:Name="WpfMajorTextBox" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Padding="6" TextChanged="VersionFields_TextChanged" />
                            <TextBox x:Name="WpfMinorTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Padding="6" TextChanged="VersionFields_TextChanged" />
                            <TextBox x:Name="WpfPatchTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" Padding="6" TextChanged="VersionFields_TextChanged" />
                            <TextBlock x:Name="CurrentWpfVersionTextBlock" Grid.Row="1" Grid.Column="3" Margin="8,6,0,0" Foreground="#5E6F62" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Android-Version" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" Text="Major" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" Text="Minor" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" Text="Patch" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,8,6" Text="Build" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Margin="8,0,0,6" Text="Aktuell" />

                            <TextBox x:Name="AndroidMajorTextBox" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Padding="6" TextChanged="VersionFields_TextChanged" />
                            <TextBox x:Name="AndroidMinorTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Padding="6" TextChanged="VersionFields_TextChanged" />
                            <TextBox x:Name="AndroidPatchTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" Padding="6" TextChanged="VersionFields_TextChanged" />
                            <TextBox x:Name="AndroidBuildTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,8,0" Padding="6" />
                            <TextBlock x:Name="CurrentAndroidVersionTextBlock" Grid.Row="1" Grid.Column="4" Margin="8,6,0,0" Foreground="#5E6F62" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,8,0,0" Foreground="#5E6F62"
                                       Text="Patch und Build werden beim Laden automatisch auf die nächste Version gesetzt, können aber manuell geändert werden." />

                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="PackageName / ApplicationId" />
                                <TextBox x:Name="AndroidPackageNameTextBox" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Play Track" />
                                <ComboBox x:Name="AndroidPlayTrackComboBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" Padding="6" SelectionChanged="AndroidPlayTrackComboBox_SelectionChanged">
                                    <ComboBoxItem Content="internal" IsSelected="True" />
                                    <ComboBoxItem Content="closed" />
                                    <ComboBoxItem Content="open" />
                                    <ComboBoxItem Content="production" />
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Publishing Status" />
                                <ComboBox x:Name="AndroidPublishingStatusComboBox" Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" Padding="6">
                                    <ComboBoxItem Content="draft" IsSelected="True" />
                                    <ComboBoxItem Content="inReview" />
                                    <ComboBoxItem Content="published" />
                                </ComboBox>

                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Store URL" />
                                <TextBox x:Name="AndroidStoreUrlTextBox" Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" Padding="6" />

                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Release Name" />
                                <TextBox x:Name="AndroidReleaseNameTextBox" Grid.Row="4" Grid.Column="1" Margin="8,0,0,0" Padding="6" TextChanged="AndroidReleaseNameTextBox_TextChanged" />
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- Unten: Release Notes + Log nebeneinander -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Release Notes (manuell)" Padding="10" Height="520" MinHeight="420">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="CopyReleaseDataButton" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" Padding="12,8" Click="CopyReleaseData_Click" Content="Release-Daten kopieren" />
                            <Button x:Name="OpenChangelogButton" Grid.Row="0" Grid.Column="1" Margin="0,0,10,10" Padding="12,8" Click="OpenChangelog_Click" Content="Changelog öffnen" />
                            <Button x:Name="LoadChangelogBlockButton" Grid.Row="0" Grid.Column="2" Margin="0,0,10,10" Padding="12,8" Click="LoadChangelogBlock_Click" Content="Aus CHANGELOG laden" />
                            <Button x:Name="SaveChangelogBlockButton" Grid.Row="0" Grid.Column="3" Margin="0,0,10,10" Padding="12,8" Click="SaveChangelogBlock_Click" Content="In CHANGELOG speichern" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Margin="0,4,0,10" Foreground="#5E6F62" TextWrapping="Wrap"
                                       Text="1) Changelog pflegen  2) Daten kopieren und in ChatGPT einfügen  3) Finalen Text hier einfügen  4) Speichern" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,0,6" Foreground="#5E6F62" TextWrapping="Wrap">
                                <Run Text="CHANGELOG.md Block: " />
                                <Run x:Name="LoadedChangelogHeaderRun" Text="(nicht geladen)" FontWeight="SemiBold" />
                            </TextBlock>

                            <TextBox x:Name="ChangelogBlockTextBox"
                                     Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,10,0,6" Foreground="#5E6F62" Text="Finaler Release-Text (aus ChatGPT)" />

                            <TextBox x:Name="ReleaseNotesTextBox"
                                     Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap" />

                            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="PasteReleaseTextButton" Width="210" Padding="12,8" Margin="0,0,10,0" Click="PasteReleaseText_Click" Content="Aus Zwischenablage einfügen" />
                                <Button x:Name="SaveReleaseTextButton" Width="170" Padding="12,8" Click="SaveReleaseText_Click" Content="Release-Text speichern" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Protokoll" Padding="10" Height="520" MinHeight="420">
                        <TextBox x:Name="LogTextBox"
                                 FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True" />
                    </GroupBox>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
