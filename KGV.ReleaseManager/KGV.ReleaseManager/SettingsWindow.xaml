<Window x:Class="KGV.ReleaseManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="900"
        Height="700"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock FontWeight="SemiBold" Text="Pfade" Margin="0,0,0,8" />

                        <TextBlock Text="Repository Root" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.RepoRoot, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Publish Root" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.PublishRoot, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="GitHub-Ordner" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.GitHubRoot, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="MAUI Projekt (.csproj)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.MauiProjectPath, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="WPF Projekt (.csproj)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.WpfProjectPath, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock FontWeight="SemiBold" Text="GitHub Release-Publishing" Margin="0,8,0,8" />

                        <TextBlock Text="Base URL (GitHub Pages)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Git Remote URL" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.GitRemoteUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Git Credential Username" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.GitCredentialUsername, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Git User Name" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.GitUserName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Git User Email (optional)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.GitUserEmail, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="KeepCount (alte Versionen behalten)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding General.KeepCount, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Android">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock FontWeight="SemiBold" Text="Defaults" Margin="0,0,0,8" />

                        <TextBlock Text="Default PackageName" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.DefaultPackageName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Default PlayTrack" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.DefaultPlayTrack, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Default PublishingStatus" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.DefaultPublishingStatus, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Default StoreUrl (optional)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.DefaultStoreUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="ReleaseName Strategie" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.ReleaseNameStrategy, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock FontWeight="SemiBold" Text="Signing" Margin="0,8,0,8" />

                        <TextBlock Text="Keystore Pfad" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.KeystorePath, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Key Alias" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.KeystoreAlias, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="StorePass Datei" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.StorePasswordFile, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="KeyPass Datei (optional, sonst StorePass)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.KeyPasswordFile, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Margin="0,4,0,10" Content="Signing ist Pflicht (Play Console)" IsChecked="{Binding Android.RequireSigning}" />

                        <TextBlock Text="Android OutputRoot (optional)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Android.OutputRoot, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Windows">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Windows OutputRoot (optional)" />
                        <TextBox Margin="0,4,0,10" Text="{Binding Windows.OutputRoot, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="UI">
                <StackPanel Margin="10">
                    <TextBlock Text="Standard Fensterbreite" />
                    <TextBox Margin="0,4,0,10" Text="{Binding Ui.WindowWidth, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="Standard Fensterhöhe" />
                    <TextBox Margin="0,4,0,10" Text="{Binding Ui.WindowHeight, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="120" Margin="0,0,10,0" Padding="10,6" IsDefault="True" Click="Save_Click" Content="Speichern" />
            <Button Width="120" Padding="10,6" IsCancel="True" Click="Cancel_Click" Content="Abbrechen" />
        </StackPanel>
    </Grid>
</Window>
