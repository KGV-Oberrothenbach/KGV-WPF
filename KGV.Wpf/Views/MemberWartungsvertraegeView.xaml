<UserControl x:Class="KGV.Views.MemberWartungsvertraegeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource KgvBackgroundBrush}">

    <Grid Margin="30">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock Text="Wartungsverträge" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Aktualisieren" Width="120" Height="30"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Margin="0,10,0,0">
                <Run Text="Mitglied: " />
                <Run Text="{Binding MemberDisplay}" FontWeight="SemiBold" />
            </TextBlock>

            <TextBlock Margin="0,6,0,0" Text="{Binding StatusText}" Foreground="DarkRed" FontWeight="SemiBold" TextWrapping="Wrap" />

            <GroupBox Header="Neue Zuordnung" Margin="0,12,0,0">
                <Grid Margin="10" IsEnabled="{Binding CanEdit}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Vertrag" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,0"
                              ItemsSource="{Binding AvailableContracts}"
                              SelectedItem="{Binding SelectedContractToAdd}"
                              DisplayMemberPath="Titel" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Gültig ab" />
                    <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding GueltigAb}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Bemerkung" Margin="0,6,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                             Text="{Binding Bemerkung, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Row="2" Grid.Column="3" Content="Zuweisen" Width="120" Height="30" Margin="0,10,0,0"
                            Command="{Binding AssignCommand}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Aktive Zuordnungen" Margin="0,12,0,0">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Bemerkung beim Beenden (optional):" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Width="260" IsEnabled="{Binding CanEdit}" Text="{Binding EndBemerkung, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding ActiveAssignments}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vertrag" Binding="{Binding Display}" Width="*" />
                            <DataGridTextColumn Header="Bemerkung" Binding="{Binding Bemerkung}" Width="220" />
                            <DataGridTemplateColumn Header="Aktion" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Beenden" Width="90" Height="24"
                                                Command="{Binding DataContext.EndAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>

            <Expander Header="Beendete Zuordnungen" Margin="0,12,0,0" IsExpanded="{Binding ShowEnded}">
                <DataGrid ItemsSource="{Binding EndedAssignments}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Height="200"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vertrag" Binding="{Binding Display}" Width="*" />
                        <DataGridTextColumn Header="Bemerkung" Binding="{Binding Bemerkung}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
