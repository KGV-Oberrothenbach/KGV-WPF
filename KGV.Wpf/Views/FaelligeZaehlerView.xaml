<UserControl x:Class="KGV.Views.FaelligeZaehlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:KGV.Wpf.Helpers"
             Background="{StaticResource KgvBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1100">
            <TextBlock Text="Fällige Zähler" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       Text="Übersicht basierend auf v_zaehler_eichstatus. Filter und Sortierung helfen beim schnellen Erkennen kritischer Fälle."
                       Foreground="{StaticResource KgvMutedBrush}"
                       TextWrapping="Wrap" />

            <ProgressBar Margin="0,12,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Border Margin="0,18,0,0"
                    Padding="14"
                    Background="{StaticResource KgvSurfaceBrush}"
                    BorderBrush="{StaticResource KgvBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="180"
                                  ItemsSource="{Binding FilterOptions}"
                                  SelectedItem="{Binding SelectedFilter}" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Content="Aktualisieren"
                            Command="{Binding ReloadCommand}" />
                </DockPanel>
            </Border>

            <Border Margin="0,18,0,0"
                    Padding="14"
                    Background="{StaticResource KgvSurfaceBrush}"
                    BorderBrush="{StaticResource KgvBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <DataGrid ItemsSource="{Binding ItemsView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          MinHeight="360">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Anlage" Binding="{Binding Anlage}" Width="*" />
                        <DataGridTextColumn Header="Garten" Binding="{Binding GartenNr}" Width="80" />
                        <DataGridTextColumn Header="Medium" Binding="{Binding Medium}" Width="110" />
                        <DataGridTextColumn Header="Zähler" Binding="{Binding Zaehlernummer}" Width="140" />
                        <DataGridTextColumn Header="Eichdatum" Binding="{Binding Eichdatum, StringFormat=dd.MM.yyyy}" Width="110" />
                        <DataGridTextColumn Header="Eichfälligkeit" Binding="{Binding EichfaelligAm, StringFormat=dd.MM.yyyy}" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                        <DataGridTextColumn Header="Tage" Binding="{Binding TageBisFaellig}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Margin="0,12,0,0"
                       Text="{Binding ErrorText}"
                       Foreground="Red"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringNotEmptyToVisibility}}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
