<UserControl x:Class="KGV.Views.AblesungErfassenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:KGV.Wpf.Helpers"
             Background="{StaticResource KgvBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900">
            <TextBlock Text="Ablesung erfassen" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />

            <TextBlock Margin="0,8,0,0"
                       Text="RFID-Tag scannen oder UID eingeben und prüfen."
                       Foreground="{StaticResource KgvMutedBrush}"
                       TextWrapping="Wrap" />

            <ProgressBar Margin="0,12,0,0"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Border Margin="0,18,0,0"
                    Padding="14"
                    Background="{StaticResource KgvSurfaceBrush}"
                    BorderBrush="{StaticResource KgvBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="RFID-UID" FontWeight="SemiBold" />
                    <TextBox Margin="0,6,0,0"
                             Text="{Binding RfidTagUid, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Margin="0,12,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Content="Prüfen"
                            Command="{Binding CheckCommand}" />

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding StatusText}"
                               Foreground="Red"
                               Visibility="{Binding StatusText, Converter={StaticResource StringNotEmptyToVisibility}}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
