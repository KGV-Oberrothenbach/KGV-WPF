<UserControl x:Class="KGV.Views.BekanntmachungenVerwaltungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:KGV.Wpf.Helpers"
             Background="{DynamicResource KgvBackgroundBrush}">

    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Width" Value="140" />
        </Style>

        <helpers:BoolToVisibilityConverterLocal x:Key="BoolToVisibility" />
        <helpers:BoolToVisibilityConverterLocal x:Key="InvertBoolToVisibility" InvertLocal="True" />
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="Bekanntmachungen" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Neu" Command="{Binding NewCommand}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="DarkRed" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     DisplayMemberPath="Titel"
                     Margin="0,0,16,0">
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                </ListBox.InputBindings>
            </ListBox>

            <Grid Grid.Column="1">
                <TextBlock Text="Doppelklick auf einen Eintrag oder 'Neu' klicken, um zu bearbeiten."
                           Foreground="#5E6F62"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsEditMode, Converter={StaticResource InvertBoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="Titel *" FontWeight="SemiBold" />
                        <TextBox Text="{Binding EditItem.Titel, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Inhalt *" FontWeight="SemiBold" Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <TextBlock Text="Schriftgröße" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="90"
                                      SelectedValue="{Binding EditItem.FontSize, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content"
                                      Margin="0,0,12,0">
                                <ComboBoxItem Content="12" />
                                <ComboBoxItem Content="14" />
                                <ComboBoxItem Content="16" />
                                <ComboBoxItem Content="18" />
                                <ComboBoxItem Content="20" />
                            </ComboBox>

                            <ToggleButton Content="Fett" IsChecked="{Binding EditItem.IsBold, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <ToggleButton Content="Kursiv" IsChecked="{Binding EditItem.IsItalic, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBox Text="{Binding EditItem.InhaltText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="240"
                                 FontSize="{Binding EditItem.FontSize}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="FontStyle" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditItem.IsBold}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EditItem.IsItalic}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Sichtbar ab" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding EditItem.SichtbarAb, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sichtbar bis" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding EditItem.SichtbarBis, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Sortierung" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBox Text="{Binding EditItem.SortOrderText, UpdateSourceTrigger=PropertyChanged}" Width="120" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Speichern" Command="{Binding SaveCommand}" />
                            <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
                            <Button Content="Deaktivieren" Command="{Binding DeactivateCommand}" />
                            <Button Content="Löschen" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
