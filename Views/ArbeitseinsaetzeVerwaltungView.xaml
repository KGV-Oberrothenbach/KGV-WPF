<UserControl x:Class="KGV.Views.ArbeitseinsaetzeVerwaltungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:KGV.Wpf.Helpers"
             Background="{DynamicResource KgvBackgroundBrush}">

    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Width" Value="140" />
        </Style>

        <helpers:BoolToVisibilityConverterLocal x:Key="BoolToVisibility" />
        <helpers:BoolToVisibilityConverterLocal x:Key="InvertBoolToVisibility" InvertLocal="True" />
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="Arbeitseinsätze" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Neu" Command="{Binding NewCommand}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="DarkRed" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     DisplayMemberPath="DisplayText"
                     Margin="0,0,16,0">
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                </ListBox.InputBindings>
            </ListBox>

            <Grid Grid.Column="1">
                <TextBlock Text="Doppelklick auf einen Eintrag oder 'Neu' klicken, um zu bearbeiten."
                           Foreground="#5E6F62"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsEditMode, Converter={StaticResource InvertBoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="Titel *" FontWeight="SemiBold" />
                        <TextBox Text="{Binding EditItem.Titel, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Beschreibung" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBox Text="{Binding EditItem.Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="140" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Datum *" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding EditItem.Datum, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Start" FontWeight="SemiBold" />
                                 <TextBox Text="{Binding EditItem.StartUhrzeit, UpdateSourceTrigger=PropertyChanged}"
                                          LostKeyboardFocus="OnTimeLostKeyboardFocus" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ende" FontWeight="SemiBold" />
                                 <TextBox Text="{Binding EditItem.EndUhrzeit, UpdateSourceTrigger=PropertyChanged}"
                                          LostKeyboardFocus="OnTimeLostKeyboardFocus" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Treffpunkt" FontWeight="SemiBold" />
                                <TextBox Text="{Binding EditItem.Treffpunkt, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Anmeldung bis" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding EditItem.AnmeldungBis, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Stundenwert" FontWeight="SemiBold" />
                                <TextBox Text="{Binding EditItem.StundenWertText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Max. Teilnehmer" FontWeight="SemiBold" />
                                <TextBox Text="{Binding EditItem.MaxTeilnehmerText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Angemeldet" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EditItem.AngemeldetCount}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Sichtbar ab" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding EditItem.SichtbarAb, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Sichtbar bis" FontWeight="SemiBold" />
                                <DatePicker SelectedDate="{Binding EditItem.SichtbarBis, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Speichern" Command="{Binding SaveCommand}" />
                            <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
                            <Button Content="Deaktivieren" Command="{Binding DeactivateCommand}" />
                            <Button Content="Löschen" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
