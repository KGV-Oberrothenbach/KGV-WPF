<UserControl x:Class="KGV.Views.WartungsvertraegeVerwaltungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:KGV.Wpf.Helpers"
             Background="{DynamicResource KgvBackgroundBrush}">

    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Width" Value="140" />
        </Style>

        <helpers:BoolToVisibilityConverterLocal x:Key="BoolToVisibility" />
        <helpers:BoolToVisibilityConverterLocal x:Key="InvertBoolToVisibility" InvertLocal="True" />
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="Wartungsverträge" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" />
                <Button Content="Neu" Command="{Binding NewCommand}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="DarkRed" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     DisplayMemberPath="Titel"
                     Margin="0,0,16,0">
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                </ListBox.InputBindings>
            </ListBox>

            <Grid Grid.Column="1">
                <TextBlock Text="Doppelklick auf einen Vertrag oder 'Neu' klicken, um zu bearbeiten."
                           Foreground="#5E6F62"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsEditMode, Converter={StaticResource InvertBoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="Titel *" FontWeight="SemiBold" />
                        <TextBox Text="{Binding EditItem.Titel, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Bereich *" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBox Text="{Binding EditItem.Bereich, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Beschreibung" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBox Text="{Binding EditItem.Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="120" />

                        <TextBlock Text="Max. aktive Zuordnungen" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBox Text="{Binding EditItem.MaxAktiveZuordnungenText, UpdateSourceTrigger=PropertyChanged}" Width="120" />

                        <CheckBox Content="Befreit von Pflichtstunden" IsChecked="{Binding EditItem.BefreitVonPflichtstunden, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" />
                        <CheckBox Content="Aktiv" IsChecked="{Binding EditItem.Aktiv, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />

                        <TextBlock Text="Bemerkung" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBox Text="{Binding EditItem.Bemerkung, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="90" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Speichern" Command="{Binding SaveCommand}" />
                            <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
