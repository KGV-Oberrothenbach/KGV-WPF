<UserControl x:Class="KGV.Views.ImpressumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Headline}" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" />

            <TextBlock Text="{Binding Developer}" Margin="0,18,0,0" />
            <TextBlock Text="{Binding Copyright}" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
