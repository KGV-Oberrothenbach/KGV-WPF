<Window x:Class="KGV.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:KGV.Helpers"
        Title="KGV Hauptfenster" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <helpers:BoolToVisibilityConverterLocal x:Key="BoolToVisibilityConverterLocal"/>
    </Window.Resources>

    <DockPanel>
        <!-- Obere Leiste -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="LightGray" Height="50" VerticalAlignment="Center">
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <StackPanel Grid.Column="0" Background="#EEE" Margin="0">
                <!-- Saison Dropdown -->
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Saison" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Margin="5"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverterLocal}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Mitglied-spezifisches Menü (sichtbar, wenn ein Mitglied ausgewählt ist) -->
                <StackPanel Margin="5" Visibility="{Binding IsMemberSelected, Converter={StaticResource BoolToVisibilityConverterLocal}}">
                    <TextBlock Text="Mitglied" FontWeight="Bold" Margin="5,10,5,4" />

                    <ItemsControl ItemsSource="{Binding MemberNavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}" Margin="5"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverterLocal}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Parzellen Tree (Beispielstruktur) -->
                    <TextBlock Text="Parzellen" Margin="5,8,5,4" />
                    <TreeView Margin="5">
                        <TreeViewItem Header="Garten A">
                            <TreeViewItem Header="Strom" />
                            <TreeViewItem Header="Wasser" />
                            <TreeViewItem Header="Dokumente" />
                        </TreeViewItem>
                        <TreeViewItem Header="Garten B">
                            <TreeViewItem Header="Strom" />
                            <TreeViewItem Header="Wasser" />
                            <TreeViewItem Header="Dokumente" />
                        </TreeViewItem>
                    </TreeView>

                    <Button Content="Garten zuordnen" Margin="5" Command="{Binding AssignGardenCommand}" />

                    <Button Content="Admin-Menü" Margin="5"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverterLocal}}" />
                </StackPanel>
            </StackPanel>

            <!-- ContentControl für Views -->
            <!-- WICHTIG: Binding auf CurrentViewModel (nicht CurrentView) -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="5"/>
        </Grid>
    </DockPanel>
</Window>